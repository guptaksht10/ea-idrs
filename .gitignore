# Docker
# Keep Dockerfile and docker-compose.yml tracked.
# Ignore local override files only if they contain machine-specific config.
docker-compose.override.yml
docker-compose.override.yaml

# Logs, databases, and temporary files
*.log
*.sqlite
*.sqlite3
*.db
tmp/
temp/

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
# ---------------------------------------------------------------- EA-IDRS ---
# Datasets never go in git (ADR-0007). Only the README and checksum manifest.
data/*
!data/README.md
!data/MANIFEST.sha256

# Generated research outputs: model bundles, run folders, tracking stores.
# Commit configs + docs that reproduce them, not the outputs themselves.
artifacts/
runs/
mlruns/
*.parquet
*.joblib
*.ubj
.ipynb_checkpoints/

# Private planning documents kept locally (research plan drafts, synopsis).
local-dev/
