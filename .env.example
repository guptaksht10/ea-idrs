# EA-IDRS environment variables. Copy to `.env` (gitignored) and adjust.
# Load it explicitly with:  uv run --env-file .env <command>
# Every variable is optional; defaults are relative to the repository root.

# Where raw/processed datasets live (useful if the dataset is on another drive).
EAIDRS_DATA_DIR=data

# Where experiment run folders are written.
EAIDRS_RUNS_DIR=runs

# Where model bundles are written and loaded from.
EAIDRS_ARTIFACTS_DIR=artifacts
